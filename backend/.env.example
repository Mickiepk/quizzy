# Copy to .env and fill in the values you get while following AWS-GUIDE.md
AWS_REGION=ap-southeast-1
QUIZZY_BUCKET=your-bucket-name
QUIZZY_KB_ID=XXXXXXXXXX
QUIZZY_DS_ID=XXXXXXXXXX
QUIZZY_MODEL_ID=global.anthropic.claude-sonnet-5-5

# No AWS keys here. Locally boto3 uses your `aws configure` / SSO profile;
# on EC2 it uses the instance's IAM role automatically.
